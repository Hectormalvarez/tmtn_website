# Docker Compose Environment Variables
# Copy this file to .env and customize as needed

# Host port mapping (container always listens on 3000 internally)
PORT=9150
DEV_PORT=8889
HOSTNAME=0.0.0.0

# GitHub API token (optional — increases rate limit from 60 to 5000 req/hr)
# Generate via: gh auth token > .env (append to existing .env)
GITHUB_TOKEN=

# Containerized cloudflared tunnel (tmtn-prod). Required by the `cloudflared`
# service in docker-compose.yml. Per-tunnel secret from the Cloudflare
# dashboard — never commit the real value.
CLOUDFLARE_TUNNEL_TOKEN=
